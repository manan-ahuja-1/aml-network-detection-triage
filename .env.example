# Copy to .env and fill in. .env is gitignored; this example file is committed so a
# reviewer (or you, on another machine) can see which credentials the project needs
# without ever seeing a value.

# --- Kaggle (needed Day 1, for dataset download) ---
# The Kaggle CLI (v2.2.x) offers three auth methods. Easiest is OAuth, which needs
# NO token here at all — just run once:
#
#     ./.venv/bin/kaggle auth login
#
# If you prefer a token instead, generate one at https://www.kaggle.com/settings/api
# ("Generate New Token" under API) and paste it below.
# NOTE: current Kaggle uses a single KAGGLE_API_TOKEN. The older
# KAGGLE_USERNAME + KAGGLE_KEY pair described in most online guides is out of date.
KAGGLE_API_TOKEN=

# --- Anthropic (needed Day 6, for the triage agent) ---
# Not required for any of Week 1. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
