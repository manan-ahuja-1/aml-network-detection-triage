# --- secrets ---
# .env holds Kaggle and Anthropic credentials. Never committed. A secret pushed once
# lives in git history forever, so this line matters more than anything else here.
.env

# --- environment ---
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- data ---
# Raw and derived data are regenerable from Kaggle via `make data`, and the CSV alone
# is hundreds of MB. The repo stays clonable; the data does not live in it.
data/

# --- results ---
# Figures and metrics JSON ARE committed: the README reads its numbers from them, so
# a reviewer sees the results without running anything. Only scratch output is ignored.
results/**/*.tmp

# --- scratch ---
# Working files and background job logs. Disposable by definition.
.tmp/

# --- macOS ---
.DS_Store

docs/LEARNING_NOTES.md
PROJECTSep.md
PROJECTSep_v3.md

# --- derived model + index artefacts ---
# The frozen booster is 15 MB and regenerable in ten minutes from `make eval`; the
# Chroma index is regenerable in one from `make kb`. The corpus they are built from
# (kb/corpus/, kb/sources.json) IS committed, because a reviewer needs to read exactly
# what the agent retrieves.
models/

# Per-row score caches. ~48 MB of float columns, regenerable from `make figures`, and
# only an input to the PR-curve chart -- the chart itself IS committed.
results/curve_scores.parquet

# Same rule, second file: 44 MB of per-row validation scores for the visibility arms,
# regenerable from `make single-bank`. Nothing reports from it -- `single_bank.py` reads it
# back to recover the arm B floor without retraining, and every number the README shows
# comes from results/*.json. Committing it would quadruple the clone for a cache.
results/single_bank_scores.parquet
